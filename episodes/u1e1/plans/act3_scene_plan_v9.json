          "type": "keywordpop"
        }
      ],
      "params": {
        "points": [
          {
            "at": 0.0,
            "text": "Five nations bound together"
          },
          {
            "at": 5.1,
            "text": "Grand Council \u2014 everyone had to agree"
          },
          {
            "at": 6.9,
            "text": "Clans traced through the mother's line chose leaders"
          },
          {
            "at": 10.1,
            "text": "No nation dragged into a war it hadn't voted for"
          }
