{"$id":"https://github.com/munishbansal2000/apush/build/passmaster/schemas/exam.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"A full-length practice exam assembled from question ids. Mirrors the May 2027 AP U.S. History exam: 55 MCQ / 55 min, 3 SAQ / 40 min, DBQ 60 min incl 15-min reading, LEQ 40 min; 3h15m total; fully digital.","properties":{"description":{"type":"string"},"formatVersion":{"enum":["2027"],"type":"string"},"id":{"pattern":"^apush-exam-[0-9]{2}$","type":"string"},"sections":{"items":{"additionalProperties":false,"properties":{"kind":{"enum":["mcq","saq","dbq","leq"]},"name":{"type":"string"},"questionIds":{"description":"Ids referencing questions/*.json. All must be pool test.","items":{"type":"string"},"minItems":1,"type":"array"},"timeMinutes":{"type":"integer"}},"required":["name","kind","timeMinutes","questionIds"],"type":"object"},"maxItems":4,"minItems":4,"type":"array"},"status":{"enum":["draft","review","final"]},"title":{"minLength":1,"type":"string"}},"required":["id","title","formatVersion","sections","status"],"title":"APUSH PassMaster Practice Exam","type":"object"}