{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.apush/lesson-video-manifest-v1.schema.json",
  "title": "APUSH lesson video manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_id", "title", "output", "tts", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "course_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "lesson_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "chapter_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "essential_question": {"type": "string", "minLength": 1},
    "learning_objectives": {"$ref": "#/$defs/nonEmptyStrings"},
    "key_terms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {"term": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}}
      }
    },
    "ap_alignment": {"$ref": "#/$defs/apAlignment"},
    "presentation": {"$ref": "#/$defs/presentation"},
    "music": {"$ref": "#/$defs/music"},
    "output": {"type": "string", "pattern": "\\.[mM][pP]4$"},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"const": 1080},
        "height": {"const": 1920},
        "fps": {"type": "integer", "minimum": 24, "maximum": 60},
        "transition_seconds": {"const": 0.2}
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["fish", "edge"]},
        "server_url": {"type": "string", "pattern": "^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?/?$"},
        "reference_audio": {"type": "string", "minLength": 1},
        "reference_text": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "settings": {"type": "object"},
        "edge_voice": {"type": "string"},
        "edge_rate": {"type": "string"},
        "edge_pitch": {"type": "string"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["none", "ollama", "meta-api"]},
        "model": {"type": "string"},
        "endpoint": {"type": "string"},
        "api_key_env": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "clip_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["none", "ltx", "meta-ui"]},
        "cookie": {"type": "string"},
        "browser": {"enum": ["chrome", "edge"]},
        "lib_dir": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "keep_open_on_failure": {"type": "boolean"},
        "meta_refusal_retries": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "still_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["none", "hatch-media", "command"]},
        "fallback_provider": {"enum": ["none", "hatch-media", "command"]},
        "search_provider": {"enum": ["wikimedia", "image-search"]},
        "media_bin": {"type": "string", "minLength": 1},
        "image_search_bin": {"type": "string", "minLength": 1},
        "command": {"oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        ]},
        "timeout_seconds": {"type": "number", "minimum": 30, "maximum": 3600},
        "orientation": {"enum": ["landscape", "square", "vertical"]},
        "image_output_format": {"enum": ["webp", "png", "jpg", "jpeg"]}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "apAlignment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "period": {"type": "string", "minLength": 1},
        "topics": {"$ref": "#/$defs/nonEmptyStrings"},
        "themes": {"$ref": "#/$defs/nonEmptyStrings"},
        "skills": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "minLength": 1},
        "visual_style": {"type": "string", "minLength": 1},
        "captions": {"type": "boolean"},
        "music": {"type": "string", "minLength": 1},
        "branding": {"type": "string", "minLength": 1}
      }
    },
    "music": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "background": {"type": "string", "minLength": 1},
        "background_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "ducking": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "threshold": {"type": "number", "minimum": 0.001, "maximum": 1},
            "ratio": {"type": "number", "minimum": 1, "maximum": 20},
            "attack_ms": {"type": "number", "minimum": 0.01, "maximum": 2000},
            "release_ms": {"type": "number", "minimum": 1, "maximum": 9000}
          }
        },
        "fade_in_sec": {"type": "number", "minimum": 0, "maximum": 10},
        "fade_out_sec": {"type": "number", "minimum": 0, "maximum": 10},
        "intro": {"type": "string", "minLength": 1},
        "intro_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "intro_duration_sec": {"type": "number", "minimum": 0.1, "maximum": 30},
        "outro": {"type": "string", "minLength": 1},
        "outro_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "outro_duration_sec": {"type": "number", "minimum": 0.1, "maximum": 30},
        "chapter_change": {"type": "string", "minLength": 1},
        "chapter_change_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "chapter_change_duration_sec": {"type": "number", "minimum": 0.1, "maximum": 10},
        "chapter_change_scene_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narration", "visual", "animation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"},
        "purpose": {"enum": ["hook", "context", "concept", "evidence", "comparison", "application", "recap", "close"]},
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "minLength": 8},
            "voice": {"type": "string"},
            "reference_audio": {"type": "string"},
            "reference_text": {"type": "string"},
            "settings": {"type": "object"}
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_image": {"type": "string"},
            "secondary_image": {"type": "string"},
            "clip": {"type": "string"},
            "layers": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["image"],
                "properties": {
                  "image": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1},
                  "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "minimum": 0.05, "maximum": 2},
                  "depth": {"type": "number", "minimum": 0, "maximum": 4}, "drift_x": {"type": "number", "minimum": -0.5, "maximum": 0.5},
                  "drift_y": {"type": "number", "minimum": -0.5, "maximum": 0.5},
                  "entrance": {"enum": ["none", "pop", "slide_left", "slide_right", "rise"]}
                }
              }
            },
            "still": {"$ref": "#/$defs/still"},
            "search": {"$ref": "#/$defs/search"}
          }
        },
        "animation": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["auto", "title", "ken_burns", "zoom", "camera_path", "callout", "timeline", "bullets", "typewriter", "map", "counter", "versus", "wipe", "ai_clip", "parallax", "source_analysis", "diagram"]}
          }
        },
        "beats": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": {"enum": ["label", "question", "stamp", "arrow", "progress", "host", "icon", "pause"]},
              "at": {"type": "number", "minimum": 0}, "cue": {"type": "string", "minLength": 1}, "offset": {"type": "number", "minimum": -10, "maximum": 10}, "duration": {"type": "number", "minimum": 0.2},
              "text": {"type": "string"}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1},
              "x2": {"type": "number", "minimum": 0, "maximum": 1}, "y2": {"type": "number", "minimum": 0, "maximum": 1},
              "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
              "style": {"type": "string"}
            }
          }
        },
        "audio": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "ambience": {"type": "string"}, "ambience_volume": {"type": "number", "minimum": 0, "maximum": 1},
            "foley": {"enum": ["paper_rustle", "quill_scratch"]},
            "foley_gain": {"type": "number", "minimum": 0, "maximum": 1},
            "foley_fade_sec": {"type": "number", "minimum": 0, "maximum": 10},
            "effects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {
              "at": {"type": "number", "minimum": 0}, "cue": {"type": "string", "minLength": 1}, "offset": {"type": "number", "minimum": -10, "maximum": 10}, "kind": {"enum": ["impact", "whoosh", "tick", "chime", "page_turn"]},
              "file": {"type": "string"}, "volume": {"type": "number", "minimum": 0, "maximum": 2}
            }}}
          }
        },
        "device": {"enum": ["hook", "redact_reveal", "reversal", "annotate", "show_ask", "date_ticker"]},
        "device_params": {"type": "object"},
        "transition": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {"type": {"enum": ["hard_cut", "crossfade", "slide", "dip_to_black"]}, "duration": {"type": "number", "minimum": 0.05, "maximum": 1.5}, "direction": {"enum": ["left", "right", "top", "bottom"]}}
        },
        "min_duration": {"type": "number", "minimum": 0.5, "maximum": 60},
        "topics": {"type": "array", "items": {"type": "string"}},
        "on_screen_text": {"$ref": "#/$defs/nonEmptyStrings"},
        "production_notes": {"type": "string", "minLength": 1},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["title", "license"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "creator": {"type": "string", "minLength": 1},
            "date": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "notes": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "still": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "provider": {"enum": ["hatch-media", "command"]},
        "fallback_provider": {"enum": ["none", "hatch-media", "command"]},
        "seed": {"type": "integer", "minimum": 0},
        "edit_of": {"type": "string", "minLength": 1},
        "edit_prompt": {"type": "string", "minLength": 1},
        "orientation": {"enum": ["landscape", "square", "vertical"]},
        "license_note": {"type": "string", "minLength": 1}
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["query"]}, {"required": ["page_title"]}],
      "properties": {
        "query": {"type": "string", "minLength": 3},
        "page_title": {"type": "string", "pattern": "^File:"},
        "provider": {"enum": ["wikimedia", "image-search"]},
        "pick": {"type": "integer", "minimum": 0},
        "min_width": {"type": "number", "minimum": 100, "maximum": 8000},
        "license": {"const": "public-domain"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
