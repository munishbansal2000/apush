build/reclaim-2027-ced/
build/reclaim-legacy-5steps-2024/
build/reclaim-legacy-princeton/
video/__pycache__/
video/markup*/
video/output/
build/lesson-videos/
video_pipeline/**/__pycache__/
ltx_api_key.txt
content_qa/pipeline/__pycache__/
content_qa/tests/__pycache__/
video/ai_clips/
video/audio/cuba/.cache/
video/ref/
video/samples/__pycache__/
video/tts/__pycache__/
# Deterministic per-turn TTS output and fingerprint cache. Keep episode scripts,
# director plans, prompts, image manifests, and other creative inputs tracked.
video/episodes/*/tts/
.gitignore
__pycache__/
assets/images/
video/audio/

# Render outputs + intermediates (regenerable). Source audio under
# video/ + video_pipeline/ stays tracked.
*-mixed.mp3
*-final.mp4
*_cache/
video-pipeline/out/
video-pipeline/episodes/*/audio/
# Per-episode work dirs: rendered mp4s + fingerprint cache sidecars are
# regenerable and often large. Reviewed scene plans stay tracked;
# measured timings.json is a run output (re-measure with the timing
# stage any time; test-voice numbers must never stand in for final).
video-pipeline/episodes/*/work/*.mp4
video-pipeline/episodes/*/work/*.fingerprint.json
# Generated AI clips (regenerable via the clips stage; LTX/5090 outputs).
video-pipeline/episodes/*/clips/
# Test-loop scratch: regenerable per-turn TTS + mixes, placeholder
# clips, and run outputs (timings, verify, director prompt).
video-pipeline/episodes/*/test_assets/
video-pipeline/episodes/*/tts/
video-pipeline/episodes/*/work/timings.json
video-pipeline/episodes/*/work/proofs/
video-pipeline/episodes/*/work/verify.json
video-pipeline/episodes/*/work/director_prompt.txt
# Downloaded image binaries are local QA only (images.json URLs are the
# source of truth). Never commit these.
video-pipeline/episodes/*/images/

# Windows work: node_modules, build outputs, lockfiles
**/node_modules/
video/remotion/out/
video/remotion/package-lock.json
remotion/

# Timing artifacts (never push - re-measure from TTS)
**/word_times.json
**/timings.json

# Work directories (regenerable intermediates)
video-pipeline/episodes/*/work/
video-pipeline/models/

# LTX job files and scene JSON (regenerable)
video-pipeline/episodes/*/ltx_jobs*.json
video-pipeline/episodes/*/trade_scenes.json
video-pipeline/episodes/*/tordesillas_scene*.json
video-pipeline/episodes/*/ltx_wiring.md

# Media (never push per standing rules)
*.mp3
*.mp4

# Local Meta UI lesson-review responses (content-hash cached)
audio_scripts/_reviews/
