{
  "_doc": "Values that lost the 2026-10-08 data/ -> src/data/ merge (P13). The in-use copy won; these are the discarded variants, kept for review.",
  "style-rules.json": {
    "_doc": "Language and structure rules enforced by the script linter (S0xx) and on-screen linter (B0xx). Edit here, never in code.",
    "speakers": [
      "maya",
      "marcus"
    ],
    "banned_phrases": [
      {
        "pattern": "\\bfun fact\\b",
        "why": "announcer voice; let the fact be fun"
      },
      {
        "pattern": "\\bthink about that( one)? for a (second|moment)\\b",
        "why": "stock filler"
      },
      {
        "pattern": "\\blet'?s dive in\\b",
        "why": "YouTube filler"
      },
      {
        "pattern": "\\bbuckle up\\b",
        "why": "YouTube filler"
      },
      {
        "pattern": "\\bwithout further ado\\b",
        "why": "filler"
      },
      {
        "pattern": "\\bit'?s important to note\\b",
        "why": "essay filler"
      },
      {
        "pattern": "\\bin today'?s (video|episode)\\b",
        "why": "filler"
      },
      {
        "pattern": "\\bcommon mistake\\b",
        "why": "announce-the-mistake device retired in v10; use a {trap} line instead"
      },
      {
        "pattern": "\\bexam tip\\b",
        "why": "announcer device retired in v10; fold the tip into a trap correction"
      }
    ],
    "terminology": [
      {
        "pattern": "\\bslaves\\b",
        "prefer": "enslaved people / enslaved Africans / captives",
        "level": "error"
      },
      {
        "pattern": "\\bNew World\\b",
        "prefer": "the Americas (quote the phrase only when quoting a source)",
        "level": "error"
      },
      {
        "pattern": "\\bdiscover(ed|y|ies)\\b",
        "prefer": "reached / arrived / encountered",
        "level": "error"
      },
      {
        "pattern": "\\bIndians\\b",
        "prefer": "Native peoples, or the specific nation",
        "level": "error"
      },
      {
        "pattern": "\\bsavages?\\b",
        "prefer": "(never, outside a labeled primary-source quote)",
        "level": "error"
      },
      {
        "pattern": "\\btribes?\\b",
        "prefer": "nation / people / confederacy",
        "level": "warn"
      },
      {
        "pattern": "\\bOld World\\b",
        "prefer": "fine in disease context; otherwise Afro-Eurasia / Europe",
        "level": "info"
      }
    ],
    "limits": {
      "maxTurnWords": 80,
      "targetWords": 1500,
      "maxWords": 1600,
      "speakerShareMin": 0.35,
      "maxConsecutiveSameSpeaker": 4,
      "shortSentenceWords": 4,
      "maxShortSentenceRatio": 0.32,
      "repeatedNgram": {
        "n": 5,
        "maxRepeats": 2
      },
      "allowedPauses": [
        5,
        10,
        15,
        20
      ],
      "predictionBeats": 2,
      "selfTestPauses": 4,
      "minTraps": 4,
      "promptVerbs": [
        "defend",
        "refute",
        "name",
        "explain",
        "identify",
        "describe",
        "compare"
      ]
    },
    "trap": {
      "_doc": "A {trap} line is a deliberate student mistake. The other speaker's very next turn must correct it with one of these markers.",
      "correctionMarkers": [
        "trap",
        "careful",
        "not so fast",
        "almost",
        "exception",
        "half an answer",
        "not quite"
      ]
    },
    "emotionMarkers": {
      "_doc": "Allowed {marker} tags at the start of a line. Emitted to Fish as (marker) only when build-tts runs with --emotion. Verify the list against your Fish model before enabling.",
      "allowed": [
        "soft tone",
        "serious",
        "sad",
        "sighing",
        "excited",
        "surprised",
        "curious",
        "confident",
        "whispering"
      ]
    },
    "onscreen": {
      "maxChars": {
        "hero": 18,
        "title": 34,
        "subtitle": 42,
        "body": 64
      },
      "emojiTones": [
        "playful"
      ],
      "maxConcurrentBeats": 3
    }
  },
