{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apush-director-transport-v1",
  "title": "APUSH Director Transport Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "episode",
    "title",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "episode": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "turnRange",
          "props",
          "transition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "enum": [
              "title",
              "ken_burns",
              "quote",
              "compare",
              "causal_chain",
              "highlight",
              "primary_source",
              "chart",
              "spectrum",
              "stagger",
              "creative_clip"
            ]
          },
          "turnRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "props": {
            "type": "object"
          },
          "transition": {
            "enum": [
              "cut",
              "crossfade",
              "dip"
            ]
          },
          "roadmapIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Index of current roadmap box (0-based). Boxes before this are checked."
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lesson roadmap boxes (e.g. ['Stamp Act', 'Virtual Representation', 'Declaratory Act'])"
    }
  }
}